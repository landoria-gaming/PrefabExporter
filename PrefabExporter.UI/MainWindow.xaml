<Window x:Class="PrefabExporter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        Title="PrefabExporter"
        Width="1050"
        Height="650">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top"
                    Margin="0,0,0,8">
            <DockPanel>
                <TextBox x:Name="PrefabName"
                         DockPanel.Dock="Left"
                         Width="340"
                         Margin="0,0,6,0"
                         TextChanged="PrefabName_TextChanged" />
                <Button x:Name="RefsButton"
                        DockPanel.Dock="Left"
                        Margin="0,0,6,0"
                        Padding="10,4"
                        Click="References_Click"
                        Content="Show references" />
                <Button x:Name="ExtractButton"
                        DockPanel.Dock="Left"
                        Margin="0,0,6,0"
                        Padding="10,4"
                        Click="Extract_Click"
                        Content="Extract" />
                <ProgressBar x:Name="OperationProgressBar"
                             Height="16"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="Operation progress"
                             Minimum="0"
                             Maximum="1"
                             Value="0"
                             Visibility="Collapsed" />
            </DockPanel>
        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom"
                   Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="GameStatus"
                           Text="Valheim path: not configured | Version: unavailable"
                           TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
        <TextBox x:Name="Output"
                 Style="{StaticResource OutputTextBox}"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 MouseDoubleClick="Output_MouseDoubleClick"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
