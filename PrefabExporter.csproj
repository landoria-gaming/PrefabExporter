<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="PrefabExporter.Core\PrefabExporter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="PrefabExporter.Core\**\*.cs" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
