<Window x:Class="PrefabExporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        Title="PrefabExporter"
        Width="1050"
        Height="650">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top"
                    Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal">
                    <Button x:Name="IndexButton"
                            Margin="0,0,6,0"
                            Padding="10,4"
                            ToolTipService.ShowOnDisabled="True"
                            Click="Index_Click"
                            Content="Index assets" />
                    <ComboBox x:Name="IndexSelector"
                              Width="120"
                              Margin="0,0,6,0"
                              DisplayMemberPath="Version"
                              SelectionChanged="IndexSelector_SelectionChanged" />
                    <Button x:Name="CancelButton"
                            Margin="0,0,6,0"
                            Padding="10,4"
                            Click="Cancel_Click"
                            Content="Cancel"
                            IsEnabled="False" />
                    <Button Padding="10,4"
                            Content="Export all"
                            IsEnabled="False" />
                </StackPanel>
                <ProgressBar x:Name="IndexProgressBar"
                             Height="16"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="Indexing progress"
                             Minimum="0"
                             Maximum="1"
                             Value="0"
                             Visibility="Collapsed" />
            </DockPanel>
            <WrapPanel>
                <TextBox x:Name="PrefabName"
                         Width="340"
                         Margin="0,0,6,0"
                         TextChanged="PrefabName_TextChanged" />
                <Button x:Name="RefsButton"
                        Margin="0,0,6,0"
                        Padding="10,4"
                        Click="References_Click"
                        Content="Show references" />
                <Button x:Name="ExtractButton"
                        Margin="0,0,6,0"
                        Padding="10,4"
                        Click="Extract_Click"
                        Content="Extract" />
                <Button x:Name="UnityExportButton"
                        Padding="10,4"
                        Click="UnityExport_Click"
                        Content="Export Unity"
                        ToolTip="Exports a Unity project from the prefab's source files; it may contain many other assets." />
            </WrapPanel>
        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom"
                   Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="GameStatus"
                           Text="Valheim path: not configured | Version: unavailable"
                           TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
        <TextBox x:Name="Output"
                 Style="{StaticResource OutputTextBox}"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 MouseDoubleClick="Output_MouseDoubleClick"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
